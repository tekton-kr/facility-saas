# 브라우저가 호출하는 조회 API. 동일 오리진이면 /api/v1
VITE_API_BASE=/api/v1

# 개발/프리뷰에서 /api 를 넘길 중앙 서버 origin. 경로 없이 호스트만.
# 예: https://api.example.com
API_ORIGIN=

# 점검 스크립트가 중앙 API에 로그인할 때 사용합니다.
CHECK_EMAIL=
CHECK_PASSWORD=

# 개발 편의. 값이 있으면 로그인 화면이 그 계정으로 바로 들어갑니다.
# 중앙 API의 POST /auth/demo 가 있을 때만 동작합니다.
# 프로덕션 빌드에서는 무시됩니다. 로그아웃 직후에는 동작하지 않습니다.
VITE_AUTO_LOGIN=
